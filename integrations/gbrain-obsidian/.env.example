# Obsidian
OBSIDIAN_VAULT_PATH=./obsidian-vault

# Optional Obsidian Local REST API
OBSIDIAN_REST_ENABLED=false
OBSIDIAN_REST_URL=https://127.0.0.1:27124
OBSIDIAN_REST_API_KEY=replace_me

# GBrain
GBRAIN_ENABLED=false
GBRAIN_SYNC_COMMAND=gbrain sync

# Ingestion
SAVE_RAW_CONTENT=false
GBRAIN_DRY_RUN=false
GBRAIN_AUTO_COMMIT=false
DEFAULT_TIMEZONE=Australia/Sydney
MIN_STORE_SCORE=3

# Model routing / local runtime
OMLX_API_KEY=replace_me
QWEN_ROUTER_API_KEY=
